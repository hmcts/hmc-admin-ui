{% extends "template.njk" %}

{% set heading = "Final state transition" if result.requestType == "final-state-transition" else "Rollback" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-xl">Support tools</span>

      {% if result.status == "success" %}
        <div class="govuk-panel govuk-panel--confirmation">
          <h1 class="govuk-panel__title">
            {{ heading }} request submitted
          </h1>
          <div class="govuk-panel__body">
            Hearing ID<br><strong>{{ result.hearingId }}</strong>
          </div>
        </div>
        <p class="govuk-body">
          {{ result.message }}
        </p>
      {% else %}
        <h1 class="govuk-heading-xl">{{ heading }} request unsuccessful</h1>

        <p class="govuk-error-message" role="alert">
          <span class="govuk-visually-hidden">Error:</span>
          The request was not processed for Hearing ID <strong>{{ result.hearingId }}</strong>.
        </p>

        <dl class="govuk-summary-list">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">
              Hearing ID
            </dt>
            <dd class="govuk-summary-list__value">
              {{ result.hearingId }}
            </dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">
              Reason
            </dt>
            <dd class="govuk-summary-list__value">
              {{ result.message }}
            </dd>
          </div>
        </dl>
      {% endif %}

      <div class="govuk-button-group">
        <a class="govuk-button" data-module="govuk-button" href="/">
          Return to Support tools
        </a>
        <a class="govuk-link" href="/singular">
          Make another singular request
        </a>
      </div>
    </div>
  </div>
{% endblock %}
