{
  "name": "hmc-admin-ui",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "NODE_ENV=production ts-node -r tsconfig-paths/register server/server.ts",
    "start:dev": "NODE_ENV=development ts-node -r tsconfig-paths/register server/server.ts",
    "lint": "stylelint **/*.scss -v -q && eslint . --ext .js,.ts && prettier --check .",
    "lint:fix": "prettier --write . .github && eslint --fix .",
    "build": "yarn webpack --config client/webpack.config.js",
    "build:prod": "NODE_ENV=production yarn webpack --mode production --config client/webpack.config.js",
    "test": "yarn test:client && yarn test:server",
    "test:coverage": "jest --coverage",
    "test:routes": "jest -c test/jest.routes.config.js",
    "test:a11y": "jest -c test/jest.server.config.js --testPathPattern=a11y",
    "test:smoke": "NODE_TLS_REJECT_UNAUTHORIZED=0 jest -c test/jest.smoke.config.js",
    "test:functional": "NODE_TLS_REJECT_UNAUTHORIZED=0 yarn playwright install && codeceptjs run --steps",
    "test:client": "ng test",
    "test:server": "jest -c test/jest.server.config.js",
    "build:ng:test": "ng build --configuration=development --output-path dist/hmc-admin-angular-ui/browser",
    "pretest:server": "yarn build:ng:test",
    "cichecks": "yarn install && yarn build && yarn rebuild puppeteer && yarn lint && yarn test && yarn test:routes && yarn test:a11y"
  },
  "dependencies": {
    "@angular/common": "^20.2.2",
    "@angular/compiler": "^20.2.2",
    "@angular/core": "^20.2.2",
    "@angular/forms": "^20.2.2",
    "@angular/material": "^20.0.5",
    "@angular/platform-browser": "^20.2.2",
    "@angular/router": "^20.2.2",
    "@cucumber/cucumber": "^12.2.0",
    "@hmcts/ccd-case-ui-toolkit": "7.2.23-exui-2761-rc3",
    "@hmcts/info-provider": "1.2.3",
    "@hmcts/nodejs-healthcheck": "1.8.5",
    "@hmcts/nodejs-logging": "4.0.4",
    "@hmcts/properties-volume": "0.0.14",
    "@ngrx/effects": "^20",
    "@ngrx/router-store": "^20",
    "@ngrx/store": "^20",
    "@types/body-parser": "1.19.5",
    "@types/config": "3.3.5",
    "@types/cookie-parser": "1.4.8",
    "@types/csurf": "1.11.2",
    "@types/es6-promisify": "6.0.1",
    "@types/glob": "8.1.0",
    "@types/helmet": "^4.0.0",
    "@types/lodash": "4.14.195",
    "@types/nunjucks": "3.2.6",
    "@types/require-directory": "2.1.2",
    "applicationinsights": "2.7.0",
    "axios": "1.7.4",
    "body-parser": "1.20.3",
    "config": "3.3.12",
    "cookie-parser": "1.4.7",
