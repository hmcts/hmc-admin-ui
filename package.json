{
  "name": "hmc-admin-ui",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "start": "NODE_ENV=production ts-node -r tsconfig-paths/register src/main/server.ts",
    "start:dev": "nodemon --config nodemon.json",
    "start:demo": "yarn build:prod && NODE_ENV=demo NODE_CONFIG_ENV=local-demo ts-node -r tsconfig-paths/register src/main/server.ts",
    "lint": "stylelint **/*.scss -v -q && eslint . --ext .js,.ts,.cjs && prettier --check .",
    "lint:fix": "prettier --write . .github && eslint --fix .",
    "build": "yarn webpack --config webpack.config.js",
    "build:prod": "NODE_ENV=production yarn webpack --mode production --config webpack.config.js",
    "test": "yarn test:unit",
    "test:unit": "jest",
    "test:coverage": "yarn install --immutable && jest --coverage",
    "test:routes": "jest -c jest.routes.config.js",
    "test:a11y": "node bin/run-a11y-tests.js",
    "test:smoke": "jest -c jest.smoke.config.js",
    "test:functional": "yarn test:playwright:functional",
    "test:accessibility:playwright": "node bin/run-playwright-accessibility.js",
    "test:a11y:playwright": "yarn test:accessibility:playwright",
    "test:setup:playwright-install-chromium": "playwright install chromium",
    "test:setup:playwright-verify-chromium": "node bin/verify-playwright-browsers.js chromium",
    "test:fullfunctional": "yarn test:functional",
    "test:playwright:functional": "sh -c 'if [ \"${1:-}\" = \"--\" ]; then shift; fi; report_dir=\"${PLAYWRIGHT_REPORT_FOLDER:-functional-output/tests/playwright-functional/odhin-report}\"; output_dir=\"${PLAYWRIGHT_OUTPUT_DIR:-functional-output/tests/playwright-functional/test-results}\"; junit_file=\"${PLAYWRIGHT_JUNIT_OUTPUT:-$report_dir/playwright-junit.xml}\"; report_file=\"${PLAYWRIGHT_REPORT_INDEX_FILENAME:-hmc-playwright-functional.html}\"; rm -rf \"$report_dir\" \"$output_dir\"; PLAYWRIGHT_REPORT_FOLDER=\"$report_dir\" PLAYWRIGHT_OUTPUT_DIR=\"$output_dir\" PLAYWRIGHT_JUNIT_OUTPUT=\"$junit_file\" PLAYWRIGHT_REPORT_INDEX_FILENAME=\"$report_file\" npx playwright test --config=playwright.functional.config.ts \"$@\"; test_status=$?; outcome=completed; if [ \"$test_status\" -ne 0 ]; then outcome=test-failure; fi; PLAYWRIGHT_REPORT_FOLDER=\"$report_dir\" PLAYWRIGHT_REPORT_INDEX_FILENAME=\"$report_file\" node bin/ensure-odhin-report.js --outcome \"$outcome\"; report_status=$?; PLAYWRIGHT_REPORT_FOLDER=\"$report_dir\" PLAYWRIGHT_JUNIT_OUTPUT=\"$junit_file\" node bin/verify-playwright-functional-report.js; verify_status=$?; if [ \"$test_status\" -ne 0 ]; then exit \"$test_status\"; fi; if [ \"$report_status\" -ne 0 ]; then exit \"$report_status\"; fi; exit \"$verify_status\"' --",
    "cichecks": "yarn install && yarn build && yarn rebuild puppeteer && yarn lint && yarn test && yarn test:routes && yarn test:a11y",
    "prepare": "husky install"
  },
  "dependencies": {
    "@dr.pogodin/csurf": "^1.18.2",
    "@hmcts/info-provider": "1.4.0",
    "@hmcts/nodejs-healthcheck": "1.8.6",
    "@hmcts/nodejs-logging": "4.0.4",
    "@hmcts/properties-volume": "1.4.1",
    "@types/body-parser": "1.19.6",
    "@types/config": "3.3.5",
    "@types/cookie-parser": "1.4.10",
    "@types/es6-promisify": "6.0.4",
    "@types/lodash": "4.17.27",
    "@types/nunjucks": "3.2.6",
    "@types/require-directory": "2.1.7",
    "applicationinsights": "2.9.8",
    "axios": "^1.20.0",
    "body-parser": "2.3.0",
    "config": "3.3.12",
    "connect-redis": "^10.0.0",
    "cookie-parser": "1.4.7",
    "express": "^5.3.0",
    "express-nunjucks": "3.1.2",
    "express-openid-connect": "2.20.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.19.0",
    "glob": "^13.0.6",
    "govuk-frontend": "^5.9.0",
    "helmet": "8.3.0",
    "jquery": "3.7.1",
    "lodash": "4.18.1",
    "multer": "^2.2.0",
    "nunjucks": "3.2.4",
    "otplib": "^13.4.1",
    "postcss": "^8.4.27",
    "redis": "^6.1.0",
    "require-directory": "2.1.1",
    "serve-favicon": "2.5.1",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "superagent": "^10.4.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "^7.26.10",
    "@babel/eslint-parser": "7.29.9",
    "@babel/preset-env": "^7.26.9",
    "@eslint/compat": "^2",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^10",
    "@playwright/test": "1.64.1",
    "@types/chai": "^5.2.1",
    "@types/chai-as-promised": "7.1.8",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/pa11y": "^5.3.7",
    "@types/serve-favicon": "^2.5.7",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "axios-debug-log": "1.0.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "9.2.1",
    "chai": "4.5.0",
    "chai-as-promised": "7.1.2",
    "chokidar": "^5.0.0",
    "copy-webpack-plugin": "9.1.0",
    "css-loader": "6.11.0",
    "debug": "4.4.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "8.10.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "html-webpack-plugin": "5.6.8",
    "husky": "8.0.3",
    "jest": "^29.4.0",
    "jest-html-reporter": "3.10.2",
    "jest-junit": "16.0.0",
    "jest-util": "29.7.0",
    "lint-staged": "13.3.0",
    "mini-css-extract-plugin": "2.10.2",
    "nock": "13.5.6",
    "node-html-parser": "^7.0.0",
    "nodemon": "2.0.22",
    "odhin-reports-playwright": "patch:odhin-reports-playwright@npm%3A1.1.8#~/.yarn/patches/odhin-reports-playwright-npm-1.1.8-a445ed88b7.patch",
    "pa11y": "^8.0.0",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "prettier": "2.8.8",
    "puppeteer": "22.15.0",
    "request": "2.88.2",
    "sass": "1.106.1",
    "sass-loader": "13.3.3",
    "sinon": "15.2.0",
    "sinon-chai": "3.7.0",
    "style-loader": "3.3.4",
    "supertest": "^7.1.0",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "webpack": "5.112.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-middleware": "7.4.6",
    "webpack-node-externals": "3.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "**/*.{js,ts,cjs}": "eslint --fix"
  },
  "resolutions": {
    "cookie@npm:^0.5.0": "npm:0.7.2"
  },
  "packageManager": "yarn@4.15.0"
}
