    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-sonarqube-unit-reporter": "^0.0.23",
    "karma-spec-reporter": "^0.0.36",
    "lint-staged": "13.2.2",
    "mini-css-extract-plugin": "2.7.6",
