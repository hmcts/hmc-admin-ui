#!groovy

properties([
[
$class       : 'GithubProjectProperty',
displayName  : 'Admin UI Webapp',
projectUrlStr: 'https://github.com/hmcts/hmc-admin-ui/'
],
pipelineTriggers([
[$class: 'GitHubPushTrigger']
]),
parameters([
  booleanParam(
    name: 'RUN_PLAYWRIGHT_ACCESSIBILITY',
    defaultValue: false,
    description: 'Manual-only: run the non-blocking Playwright accessibility pack and publish its separate Odhín report.'
  )
])
])

@Library("Infrastructure@2.5.0")

import uk.gov.hmcts.contino.AppPipelineDsl

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [
    $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar
  ]
}

def type = "nodejs"
def product = "hmc"
def component = "admin-ui"

def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)
def playwrightFunctionalOutputRoot = 'functional-output/tests/playwright-functional'
def playwrightFunctionalReportFile = 'hmc-playwright-functional.html'
def playwrightAccessibilityOutputRoot = 'functional-output/tests/playwright-accessibility'
def playwrightAccessibilityReportFile = 'hmc-playwright-accessibility.html'
def playwrightBrowsersEnv = {
  ["PLAYWRIGHT_BROWSERS_PATH=${env.WORKSPACE}/.cache/ms-playwright"]
}

def configurePlaywrightFunctional = { String targetEnvironment ->
  def deployedEnvironment = env.ENVIRONMENT_NAME ?: targetEnvironment ?: 'aat'
  def testUrl = env.TEST_URL
  if (!testUrl) {
    throw new IllegalStateException('CNP must provide TEST_URL for protected Playwright tests')
  }
  env.PLAYWRIGHT_BROWSERS_PATH = "${env.WORKSPACE}/.cache/ms-playwright"
  env.PLAYWRIGHT_OUTPUT_DIR = "${playwrightFunctionalOutputRoot}/test-results"
  env.PLAYWRIGHT_JUNIT_OUTPUT = "${playwrightFunctionalOutputRoot}/odhin-report/playwright-junit.xml"
  env.PLAYWRIGHT_REPORT_FOLDER = "${playwrightFunctionalOutputRoot}/odhin-report"
  env.PLAYWRIGHT_REPORT_INDEX_FILENAME = playwrightFunctionalReportFile
  env.TEST_URL = testUrl
  env.IDAM_PUBLIC_URL = "https://hmcts-access.${deployedEnvironment}.platform.hmcts.net"
  env.TEST_TYPE = targetEnvironment
}

def publishPlaywrightFunctional = { String reportName ->
  steps.sh "node bin/verify-playwright-functional-report.js"
  steps.publishHTML([
    allowMissing         : false,
    alwaysLinkToLastBuild: true,
    keepAll              : true,
    reportDir            : "${playwrightFunctionalOutputRoot}/odhin-report/",
    reportFiles          : playwrightFunctionalReportFile,
    reportName           : reportName
  ])
  steps.junit allowEmptyResults: false, testResults: "${playwrightFunctionalOutputRoot}/odhin-report/playwright-junit.xml"
  steps.archiveArtifacts allowEmptyArchive: false, artifacts: "${playwrightFunctionalOutputRoot}/**"
}

def configurePlaywrightAccessibility = { String targetEnvironment ->
  def deployedEnvironment = env.ENVIRONMENT_NAME ?: targetEnvironment ?: 'aat'
  def testUrl = env.TEST_URL
  if (!testUrl) {
    throw new IllegalStateException('CNP must provide TEST_URL for protected Playwright tests')
  }
  [
    "PLAYWRIGHT_BROWSERS_PATH=${env.WORKSPACE}/.cache/ms-playwright",
    "PLAYWRIGHT_OUTPUT_DIR=${playwrightAccessibilityOutputRoot}/test-results",
    "PLAYWRIGHT_JUNIT_OUTPUT=${playwrightAccessibilityOutputRoot}/playwright-accessibility-junit.xml",
    "PLAYWRIGHT_REPORT_FOLDER=${playwrightAccessibilityOutputRoot}/odhin-report",
    "PLAYWRIGHT_REPORT_INDEX_FILENAME=${playwrightAccessibilityReportFile}",
    "TEST_URL=${testUrl}",
    "IDAM_PUBLIC_URL=https://hmcts-access.${deployedEnvironment}.platform.hmcts.net",
    "TEST_TYPE=${targetEnvironment}"
  ]
}

def publishPlaywrightAccessibility = { String reportName ->
  steps.publishHTML([
    allowMissing         : true,
    alwaysLinkToLastBuild: true,
    keepAll              : true,
    reportDir            : "${playwrightAccessibilityOutputRoot}/odhin-report/",
    reportFiles          : playwrightAccessibilityReportFile,
    reportName           : reportName
  ])
  steps.junit allowEmptyResults: true, skipMarkingBuildUnstable: true,
    testResults: "${playwrightAccessibilityOutputRoot}/playwright-accessibility-junit.xml"
  steps.archiveArtifacts allowEmptyArchive: true, artifacts: "${playwrightAccessibilityOutputRoot}/**"
}

def runPlaywrightAccessibility = { String targetEnvironment, String reportName ->
  withEnv(configurePlaywrightAccessibility(targetEnvironment)) {
    try {
      yarnBuilder.yarn('test:accessibility:playwright')
    } catch (Exception e) {
      if (e instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
        throw e
      }
      currentBuild.result = 'UNSTABLE'
      echo "[playwright-accessibility] Accessibility pack failed but remains report-only: ${e.getClass().getName()}: ${e.getMessage()}"
    } finally {
      publishPlaywrightAccessibility(reportName)
    }
  }
}

def diagnosticPullRequest = env.CHANGE_ID
if (env.CHANGE_BRANCH != 'test/EXUI-5429-preview-diagnostic-20261023' ||
    env.CHANGE_TARGET != 'test/EXUI-5429-retire-codecept' ||
    !(diagnosticPullRequest ==~ /[1-9][0-9]*/) ||
    env.BRANCH_NAME != "PR-${diagnosticPullRequest}" ||
    params.RUN_PLAYWRIGHT_ACCESSIBILITY) {
  error('Diagnostic PR context/profile mismatch')
}
def diagnosticPreviewTarget = "https://hmc-admin-ui-pr-${diagnosticPullRequest}.preview.platform.hmcts.net"
def diagnosticPreviewSource = null
def diagnosticPreviewReceiptTarget = null
def diagnosticPreviewProbeFailure = null

def secrets = [
  'hmc-${env}': [
    secret('hmc-admin-ui-test-user', 'TEST_IDAM_USERNAME'),
    secret('hmc-admin-ui-test-password', 'TEST_IDAM_PASSWORD')
  ]
]

def branchesToSync = ['perftest', 'ithc']

withPipeline(type, product, component) {
  loadVaultSecrets(secrets)
  syncBranchesWithMaster(branchesToSync)

  def publishTestReports = {
    junit allowEmptyResults: true, testResults: 'functional-output/tests/jest-unit/*.xml'
    junit allowEmptyResults: true, testResults: 'functional-output/tests/jest-smoke/*.xml'

    archiveArtifacts allowEmptyArchive: true,
      artifacts: 'test-results/**/*,playwright-report/**/*,functional-output/**/*,smoke-output/**/*',
      excludes: "${playwrightFunctionalOutputRoot}/**,${playwrightAccessibilityOutputRoot}/**"
  }

  afterSuccess('build') {
    yarnBuilder.yarn('rebuild puppeteer')
    yarnBuilder.yarn('build')
  }

  afterSuccess('checkout') {
    if (!(env.GIT_COMMIT ==~ /[a-f0-9]{40}/) ||
        steps.sh(returnStdout: true, script: 'git rev-parse HEAD').trim() != env.GIT_COMMIT) {
      error('Diagnostic checkout source mismatch')
    }
    diagnosticPreviewSource = env.GIT_COMMIT
    stage('Playwright Install Chromium') {
      withEnv(playwrightBrowsersEnv()) {
        steps.sh 'mkdir -p "$PLAYWRIGHT_BROWSERS_PATH"'
        yarnBuilder.yarn('playwright --version')
        yarnBuilder.yarn('test:setup:playwright-install-chromium')
        yarnBuilder.yarn('test:setup:playwright-verify-chromium')
      }
    }
  }

  afterSuccess('test') {
    yarnBuilder.yarn('test:unit')
  }

  afterAlways('test') {
    publishTestReports()
  }

  afterAlways('smoketest:preview') {
    publishTestReports()
  }

  afterSuccess('akschartsinstall') {
    diagnosticPreviewProbeFailure = null
    diagnosticPreviewReceiptTarget = null
    def diagnosticContextMatches = false
    try {
      diagnosticContextMatches = env.GIT_COMMIT == diagnosticPreviewSource &&
        diagnosticPreviewSource ==~ /[a-f0-9]{40}/ &&
        env.CHANGE_ID == diagnosticPullRequest &&
        env.CHANGE_BRANCH == 'test/EXUI-5429-preview-diagnostic-20261023' &&
        env.CHANGE_TARGET == 'test/EXUI-5429-retire-codecept' &&
        env.BRANCH_NAME == "PR-${diagnosticPullRequest}" &&
        new uk.gov.hmcts.contino.Subscription(env).previewName == 'nonprod' &&
        env.TEAM_NAMESPACE == 'hmc' &&
        env.AKS_TEST_URL == diagnosticPreviewTarget &&
        env.AKS_CLUSTER_NAME == 'cft-preview-00-aks' &&
        env.AKS_RESOURCE_GROUP == 'cft-preview-00-rg' &&
        !params.RUN_PLAYWRIGHT_ACCESSIBILITY
    } catch (Exception ignored) {
      diagnosticContextMatches = false
    }
    if (!diagnosticContextMatches) {
      error('Diagnostic deployment/source/profile mismatch')
    } else {
      timeout(time: 1, unit: 'MINUTES') {
        def probeOutput = null
        try {
          probeOutput = steps.sh(label: 'Read scoped Preview identity', returnStdout: true, script: '''set +x
node <<'DIAGNOSTIC_NODE'
const { execFileSync } = require('node:child_process');
const https = require('node:https');
const source = process.env.GIT_COMMIT;
const pullRequest = process.env.CHANGE_ID;
const lastCommitTimestamp = (process.env.LAST_COMMIT_TIMESTAMP || '').trim();
const release = 'hmc-admin-ui-pr-' + pullRequest;
const target = 'https://' + release + '.preview.platform.hmcts.net';
const phaseCodes = ['CONTEXT', 'CHECKOUT', 'PODS_QUERY', 'PODS_VALIDATE', 'INFO_TRANSPORT', 'INFO_STATUS', 'INFO_SIZE', 'INFO_JSON', 'INFO_IDENTITY', 'INTERNAL'];
function reject(phase) { const error = new Error(); error.phase = phase; throw error; }
function requireIdentity(ok, phase) { if (!ok) reject(phase); }
function parsePods(text) {
  const rows = text.split('\\n').filter(Boolean).map(line => line.split('\\t'));
  const pods = new Map();
  for (const row of rows) {
    requireIdentity(row.length === 2 || row.length === 4 || row.length === 6, 'PODS_VALIDATE');
    const [pod, uid] = row;
    requireIdentity(/^[a-z0-9.-]+$/.test(pod) && /^[a-f0-9-]{36}$/.test(uid), 'PODS_VALIDATE');
    if (row.length === 2) {
      requireIdentity(!pods.has(pod), 'PODS_VALIDATE');
      pods.set(pod, { uid, containers: [], statuses: [] });
    } else {
      const selected = pods.get(pod);
      requireIdentity(selected && selected.uid === uid, 'PODS_VALIDATE');
      const records = row.length === 4 ? selected.containers : selected.statuses;
      requireIdentity(/^[a-z0-9.-]+$/.test(row[2]) && !records.some(record => record[2] === row[2]), 'PODS_VALIDATE');
      records.push(row);
    }
  }
  requireIdentity(pods.size > 0, 'PODS_VALIDATE');
  const apps = [];
  const digest = /sha256:[a-f0-9]{64}$/;
  const repository = 'hmc/admin-ui:pr-' + pullRequest + '-' + source.slice(0, 7) + '-' + lastCommitTimestamp;
  const sourceImage = new RegExp('^[a-z0-9.-]+(?::[0-9]+)?/' + repository + '$');
  for (const selected of pods.values()) {
    const matches = selected.containers.filter(row => /\\/hmc\\/admin-ui(?=[:@])/.test(row[3]));
    requireIdentity(matches.length === 1, 'PODS_VALIDATE');
    const [pod, uid, container, image] = matches[0];
    const status = selected.statuses.find(row => row[2] === container);
    requireIdentity(status && status[3] === image && sourceImage.test(image) && digest.test(status[4]) && status[5] === 'true', 'PODS_VALIDATE');
    const imageID = status[4];
    apps.push({ pod, uid, container, repository, imageID: imageID.match(digest)[0] });
  }
  requireIdentity(new Set(apps.map(app => app.imageID)).size === 1, 'PODS_VALIDATE');
  return apps;
}
function parseBuild(body) {
  let parsed;
  try { parsed = JSON.parse(body); } catch { reject('INFO_JSON'); }
  requireIdentity(parsed && typeof parsed === 'object' && !Array.isArray(parsed) && parsed.build && typeof parsed.build === 'object' && !Array.isArray(parsed.build), 'INFO_IDENTITY');
  const build = parsed.build;
  requireIdentity(build && build.commit === source, 'INFO_IDENTITY');
  const result = { commit: build.commit };
  for (const key of ['version', 'number', 'date']) {
    const value = build[key];
    requireIdentity(value == null || ((typeof value === 'string' || typeof value === 'number') && /^[A-Za-z0-9 :+._/\\-]{1,100}$/.test(String(value))), 'INFO_IDENTITY');
    result[key] = value == null ? null : value;
  }
  return result;
}
async function info() {
  return new Promise((resolve, reject) => {
    let request;
    try {
      request = https.get(target + '/info', { signal: AbortSignal.timeout(15_000) }, response => {
        response.on('error', () => reject(Object.assign(new Error(), { phase: 'INFO_TRANSPORT' })));
        if (response.statusCode !== 200) { response.resume(); reject(Object.assign(new Error(), { phase: 'INFO_STATUS' })); return; }
        let size = 0;
        const chunks = [];
        response.on('data', chunk => { size += chunk.length; if (size > 64 * 1024) { response.destroy(); reject(Object.assign(new Error(), { phase: 'INFO_SIZE' })); } else chunks.push(chunk); });
        response.on('end', () => { try { resolve(parseBuild(Buffer.concat(chunks).toString('utf8'))); } catch (error) { reject(error); } });
      });
      request.on('error', () => reject(Object.assign(new Error(), { phase: 'INFO_TRANSPORT' })));
    } catch {
      reject(Object.assign(new Error(), { phase: 'INFO_TRANSPORT' }));
    }
  });
}
async function main() {
  requireIdentity(/^[a-f0-9]{40}$/.test(source) && /^[1-9][0-9]*$/.test(pullRequest) && /^[0-9]{14}$/.test(lastCommitTimestamp), 'CONTEXT');
  requireIdentity(process.env.CHANGE_BRANCH === 'test/EXUI-5429-preview-diagnostic-20261023' && process.env.CHANGE_TARGET === 'test/EXUI-5429-retire-codecept' && process.env.BRANCH_NAME === 'PR-' + pullRequest, 'CONTEXT');
  requireIdentity(process.env.AKS_TEST_URL === target && process.env.TEAM_NAMESPACE === 'hmc' && process.env.AKS_CLUSTER_NAME === 'cft-preview-00-aks' && process.env.AKS_RESOURCE_GROUP === 'cft-preview-00-rg', 'CONTEXT');
  let checkout;
  try {
    checkout = execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], timeout: 10_000 }).trim();
  } catch {
    reject('CHECKOUT');
  }
  requireIdentity(checkout === source, 'CHECKOUT');
  const projection = '{{range .items}}{{.metadata.name}}{{"\\\\t"}}{{.metadata.uid}}{{"\\\\n"}}{{$pod := .}}{{range .spec.containers}}{{$pod.metadata.name}}{{"\\\\t"}}{{$pod.metadata.uid}}{{"\\\\t"}}{{.name}}{{"\\\\t"}}{{.image}}{{"\\\\n"}}{{end}}{{range .status.containerStatuses}}{{$pod.metadata.name}}{{"\\\\t"}}{{$pod.metadata.uid}}{{"\\\\t"}}{{.name}}{{"\\\\t"}}{{.image}}{{"\\\\t"}}{{.imageID}}{{"\\\\t"}}{{.ready}}{{"\\\\n"}}{{end}}{{end}}';
  let podOutput;
  try {
    podOutput = execFileSync('kubectl', ['get', 'pods', '--namespace', 'hmc', '--selector', 'app.kubernetes.io/instance=' + release + ',!job-name', '--request-timeout=20s', '-o', 'go-template=' + projection], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], timeout: 25_000, maxBuffer: 64 * 1024 });
  } catch {
    reject('PODS_QUERY');
  }
  const pods = parsePods(podOutput);
  const build = await info();
  return { observed_utc: new Date().toISOString(), source, target, namespace: 'hmc', release, cluster: process.env.AKS_CLUSTER_NAME, resource_group: process.env.AKS_RESOURCE_GROUP, build, app_pods: pods };
}
main().then(receipt => process.stdout.write('PROBE_OK:' + JSON.stringify(receipt) + '\\n')).catch(error => {
  const phase = phaseCodes.includes(error && error.phase) ? error.phase : 'INTERNAL';
  process.stdout.write('PROBE_FAILURE:' + phase + '\\n');
});
DIAGNOSTIC_NODE
''').trim()
        } catch (Exception e) {
          if (e instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
            throw e
          }
          diagnosticPreviewProbeFailure = 'PROBE_EXECUTION'
        }
        if (diagnosticPreviewProbeFailure == null) {
          if (probeOutput?.startsWith('PROBE_FAILURE:')) {
            def phase = probeOutput.substring('PROBE_FAILURE:'.length())
            def allowedPhases = ['CONTEXT', 'CHECKOUT', 'PODS_QUERY', 'PODS_VALIDATE', 'INFO_TRANSPORT', 'INFO_STATUS', 'INFO_SIZE', 'INFO_JSON', 'INFO_IDENTITY', 'INTERNAL']
            diagnosticPreviewProbeFailure = allowedPhases.contains(phase) ? phase : 'PROBE_OUTPUT'
          } else if (probeOutput?.startsWith('PROBE_OK:')) {
            def receipt = null
            try {
              receipt = steps.readJSON(text: probeOutput.substring('PROBE_OK:'.length()), returnPojo: true)
            } catch (Exception e) {
              if (e instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
                throw e
              }
              diagnosticPreviewProbeFailure = 'RECEIPT_PARSE'
            }
            if (diagnosticPreviewProbeFailure == null) {
              def build = null
              def appPods = null
              def receiptValid = false
              try {
                build = receipt instanceof Map ? receipt.build : null
                appPods = receipt instanceof Map ? receipt.app_pods : null
                receiptValid = receipt instanceof Map &&
                  receipt.source == diagnosticPreviewSource && receipt.target == diagnosticPreviewTarget &&
                  receipt.namespace == 'hmc' && receipt.release == "hmc-admin-ui-pr-${diagnosticPullRequest}" &&
                  receipt.cluster == 'cft-preview-00-aks' && receipt.resource_group == 'cft-preview-00-rg' &&
                  build instanceof Map && build.commit == diagnosticPreviewSource &&
                  appPods instanceof List && !appPods.isEmpty()
              } catch (Exception e) {
                if (e instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
                  throw e
                }
                diagnosticPreviewProbeFailure = 'RECEIPT_IDENTITY'
              }
              if (diagnosticPreviewProbeFailure == null && receiptValid) {
                try {
                  def receiptArtifact = [
                    observed_utc: receipt.observed_utc,
                    source: receipt.source,
                    target: receipt.target,
                    namespace: receipt.namespace,
                    release: receipt.release,
                    cluster: receipt.cluster,
                    resource_group: receipt.resource_group,
                    build: [commit: build.commit, version: build.version, number: build.number, date: build.date],
                    app_pods: appPods.collect { app ->
                      [pod: app.pod, uid: app.uid, container: app.container, repository: app.repository, imageID: app.imageID]
                    }
                  ]
                  writeFile(file: 'diagnostic-output/preview-identity.json', text: groovy.json.JsonOutput.toJson(receiptArtifact) + '\n')
                  archiveArtifacts(allowEmptyArchive: false, artifacts: 'diagnostic-output/preview-identity.json')
                  diagnosticPreviewReceiptTarget = env.AKS_TEST_URL
                } catch (Exception e) {
                  if (e instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
                    throw e
                  }
                  diagnosticPreviewProbeFailure = 'RECEIPT_ARTIFACT'
                }
              } else if (diagnosticPreviewProbeFailure == null) {
                diagnosticPreviewProbeFailure = 'RECEIPT_IDENTITY'
              }
            }
          } else {
            diagnosticPreviewProbeFailure = 'PROBE_OUTPUT'
          }
        }
      }
    }
  }

  before('functionalTest:preview') {
    if (diagnosticPreviewProbeFailure != null) {
      echo("Preview identity probe phase: ${diagnosticPreviewProbeFailure}")
      error("Preview identity probe failed: ${diagnosticPreviewProbeFailure}")
    }
    configurePlaywrightFunctional('preview')
    if (env.GIT_COMMIT != diagnosticPreviewSource ||
        !(diagnosticPreviewSource ==~ /[a-f0-9]{40}/) ||
        diagnosticPreviewReceiptTarget != diagnosticPreviewTarget ||
        env.TEST_URL != diagnosticPreviewReceiptTarget || params.RUN_PLAYWRIGHT_ACCESSIBILITY) {
      error('Diagnostic receipt/test target mismatch')
    }
  }

  afterAlways('functionalTest:preview') {
    try {
      publishPlaywrightFunctional('PREVIEW HMC Admin UI Playwright Functional Test')
    } finally {
      try {
        publishTestReports()
      } finally {
        if (params.RUN_PLAYWRIGHT_ACCESSIBILITY) {
          runPlaywrightAccessibility('preview', 'PREVIEW HMC Admin UI Playwright Accessibility Test')
        }
      }
    }
  }

  before('fullFunctionalTest:preview') {
    configurePlaywrightFunctional('preview')
  }

  afterAlways('fullFunctionalTest:preview') {
    try {
      publishPlaywrightFunctional('PREVIEW HMC Admin UI Playwright Functional Test')
    } finally {
      try {
        publishTestReports()
      } finally {
        if (params.RUN_PLAYWRIGHT_ACCESSIBILITY) {
          runPlaywrightAccessibility('preview', 'PREVIEW HMC Admin UI Playwright Accessibility Test')
        }
      }
    }
  }

  before('functionalTest:aat') {
    configurePlaywrightFunctional('aat')
  }

  afterAlways('functionalTest:aat') {
    try {
      publishPlaywrightFunctional('AAT HMC Admin UI Playwright Functional Test')
    } finally {
      try {
        publishTestReports()
      } finally {
        if (params.RUN_PLAYWRIGHT_ACCESSIBILITY) {
          runPlaywrightAccessibility('aat', 'AAT HMC Admin UI Playwright Accessibility Test')
        }
      }
    }
  }

  before('fullFunctionalTest:aat') {
    configurePlaywrightFunctional('aat')
  }

  afterAlways('fullFunctionalTest:aat') {
    try {
      publishPlaywrightFunctional('AAT HMC Admin UI Playwright Functional Test')
    } finally {
      try {
        publishTestReports()
      } finally {
        if (params.RUN_PLAYWRIGHT_ACCESSIBILITY) {
          runPlaywrightAccessibility('aat', 'AAT HMC Admin UI Playwright Accessibility Test')
        }
      }
    }
  }

  afterAlways('smoketest:aat') {
    publishTestReports()
  }

}
