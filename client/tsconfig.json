{
  "compilerOptions": {
    "sourceMap": true,
    "outDir": "./client/",
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2020",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": false,
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "lib": ["es2020", "dom", "dom.iterable"],
    "baseUrl": "client",
    "paths": {
      "router/*": ["router/*"],
      "routes/*": ["routes/*"]
    }
  },
  "include": [
    "main.ts",
    "polyfills.ts",
    "assets/js/index.ts",
    "app/containers/**/*.ts",
    "app/store/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "**/*.test.ts", 
    "**/codecept.conf.ts", 
    "**/__mocks__/*", 
    "**/*.spec.ts",
    "app/app.module.ts",
    "app/app.constants.ts",
    "app/routes/app-routing.module.ts",
    "app/enums/**/*.ts",
    "app/models/**/*.ts",
    "app/services/**/*.ts",
    "environments/**/*.ts",
    "models/**/*.ts",
    "shared/**/*.ts"
  ]
}
