{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["jasmine", "node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "commonjs",
    "target": "es2017",
    "importHelpers": true
  },
  "include": ["app/**/*.spec.ts", "app/**/*.ts"],
  "exclude": ["test/steps/*"]
}
